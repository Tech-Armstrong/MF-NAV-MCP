# Secrets — NEVER commit. Both hold a live Azure Storage key.
.env
.cursor/mcp.json

# Python virtual environment
venv/
.venv/

# Local blob cache (BLOB_CACHE_DIR); parquet downloaded from Azure Blob.
.cache/
_blobcache*/

# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Local synthetic fixture (prod reads from Azure Blob via env vars).
# Generated by make_sample_data.py; not real fund data.
#
# Note the pattern: `data/*` rather than `data/`. A directory-level ignore stops
# git descending into it at all, so the negations below would never be seen.
data/*

# ...except the index benchmarks, which ARE committed. Unlike the NAV parquet
# (large, daily, read from Blob at runtime) this is small and rarely changes, so
# the server reads it as a plain local file with no network dependency. Refresh
# with `python fetch_index_data.py` and commit the result.
!data/index_history.parquet
!data/index_master.parquet

# Local pipeline staging / logs (SIF pipeline, if you build it out)
sif/data/
logs/
